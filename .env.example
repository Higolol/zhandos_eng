# Шаблон. Реальные значения — в F:\Английский\secrets\.env.local (вне репозитория).
# T3 копирует этот файл в app/.env.example (его можно коммитить).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
PROXY_AUTH_HEADER=
PROXY_AUTH_VALUE=
# Для продакшена (T9), не секрет: адрес Worker-прокси
VITE_PROXY_URL=
